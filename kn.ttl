@prefix kn:      <https://ivy.example/kn#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .

#################################################################
#    Ontology header
#################################################################

<https://ivy.example/kn> a owl:Ontology ;
    owl:versionIRI <https://ivy.example/kn/0.3.4> ;
    owl:priorVersion <https://ivy.example/kn/0.3.3> ;
    owl:versionInfo "0.3.4" ;
    rdfs:label "Vocabular BrainWizard pentru notițe de cercetare"@ro ,
               "BrainWizard research notes vocabulary"@en ;
    rdfs:comment """Teme, studii, demersuri, notițe, argumentare Toulmin, reificare în artefacte
de inginerie și trasabilitate formală de la literatură la proiectare."""@ro ,
                 """Themes, studies, endeavors, notes, Toulmin argumentation, reification into
engineering artifacts, and formal traceability from literature to design."""@en .

#################################################################
#    0. Declarations of reused terms (keeps the file OWL 2 DL)
#################################################################

skos:Concept         a owl:Class .
skos:ConceptScheme   a owl:Class .
skos:inScheme        a owl:ObjectProperty .
skos:topConceptOf    a owl:ObjectProperty .
skos:broader         a owl:ObjectProperty .
skos:notation        a owl:DatatypeProperty .
skos:prefLabel       a owl:AnnotationProperty .
skos:definition      a owl:AnnotationProperty .

dcterms:abstract     a owl:DatatypeProperty .
dcterms:subject      a owl:ObjectProperty .
dcterms:created      a owl:DatatypeProperty .
dcterms:modified     a owl:DatatypeProperty .
dcterms:format       a owl:DatatypeProperty .

oa:SpecificResource  a owl:Class .
oa:TextQuoteSelector a owl:Class .
oa:hasSource         a owl:ObjectProperty .
oa:hasSelector       a owl:ObjectProperty .
oa:exact             a owl:DatatypeProperty .

prov:wasDerivedFrom  a owl:ObjectProperty .
prov:wasRevisionOf   a owl:ObjectProperty .
prov:Activity        a owl:Class .
prov:wasGeneratedBy  a owl:ObjectProperty .
prov:used            a owl:ObjectProperty .
prov:wasAssociatedWith a owl:ObjectProperty .
prov:endedAtTime     a owl:DatatypeProperty .

#################################################################
#    1. Module: organization (themes, studies, endeavors)
#################################################################

kn:ThemeScheme a skos:ConceptScheme ;
    skos:prefLabel "Teme"@ro , "Themes"@en ;
    skos:definition "Temele sunt concepte SKOS; ierarhia lor se exprimă cu skos:broader."@ro ,
                    "Themes are SKOS concepts; their hierarchy is expressed with skos:broader."@en .

kn:Study a owl:Class ;
    rdfs:label "Studiu"@ro , "Study"@en ;
    rdfs:comment "O unitate de lucru proprie, cu o metodă, având o singură casă: o temă sau un demers."@ro ,
                 "A unit of your own work, with a method, having exactly one home: a theme or an endeavor."@en .

kn:Endeavor a owl:Class ;
    rdfs:label "Demers"@ro , "Endeavor"@en ;
    rdfs:comment """Lucru orientat spre un scop, care aplică cunoașterea din teme prin studii de caz.
Poate fi finit (de ex. teza) sau continuu. Nu este o temă: temele sunt domenii de cunoaștere
(concepte SKOS); un demers este o entitate care are întrebări, studii și o stare."""@ro ,
                 """Goal-driven work that applies knowledge from themes through case studies.
May be finite (e.g. the dissertation) or ongoing. Not a theme: themes are knowledge domains
(SKOS concepts); an endeavor is an entity with questions, studies and a status."""@en .

kn:DissertationSection a owl:Class ;
    rdfs:label "Secțiune a tezei"@ro , "Dissertation section"@en .

kn:homeTheme a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "temă de origine"@ro , "home theme"@en ;
    rdfs:comment "Studiu de recenzie care aparține unei teme."@ro ,
                 "A review study that belongs to a theme."@en ;
    rdfs:domain kn:Study ;
    rdfs:range skos:Concept .

kn:homeEndeavor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "demers de origine"@ro , "home endeavor"@en ;
    rdfs:domain kn:Study ;
    rdfs:range kn:Endeavor .

kn:examines a owl:ObjectProperty ;
    rdfs:label "examinează"@ro , "examines"@en ;
    rdfs:comment "Sursa (carte, articol) studiată; de regulă un bibo:Document."@ro ,
                 "The source (book, paper) under study; typically a bibo:Document."@en ;
    rdfs:domain kn:Study .

kn:method a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "metodă"@ro , "method"@en ;
    rdfs:domain kn:Study ;
    rdfs:range skos:Concept .

kn:drawsOn a owl:ObjectProperty ;
    rdfs:label "se bazează pe"@ro , "draws on"@en ;
    rdfs:comment """Derivată, nu se afirmă manual: un studiu de caz se bazează pe un studiu de recenzie
când o notă din studiul de caz se trage (direct sau tranzitiv) dintr-o notă sau un extras al acelui studiu.
Calculată de regula kn-derive-drawsOn.rq în graful inferat."""@ro ,
                 """Derived, never asserted by hand: a case study draws on a review study when a note in the
case study traces (directly or transitively) to a note or excerpt of that review study.
Computed by the rule kn-derive-drawsOn.rq into the inferred graph."""@en ;
    rdfs:domain kn:Study ;
    rdfs:range kn:Study .

kn:isDrawnOnBy a owl:ObjectProperty ;
    rdfs:label "este folosit de"@ro , "is drawn on by"@en ;
    rdfs:comment "Vederea din partea studiului de recenzie: studiile de caz care îl folosesc."@ro ,
                 "The review study's view: the case studies that use it."@en ;
    owl:inverseOf kn:drawsOn .

kn:usesStudy a owl:ObjectProperty ;
    rdfs:label "folosește studiul"@ro , "uses study"@en ;
    rdfs:comment "Derivată: un demers folosește fiecare studiu de recenzie pe care se bazează studiile sale de caz."@ro ,
                 "Derived: an endeavor uses every review study its case studies draw on."@en ;
    owl:propertyChainAxiom ( [ owl:inverseOf kn:homeEndeavor ] kn:drawsOn ) .

kn:hasResearchQuestion a owl:ObjectProperty ;
    rdfs:label "are întrebarea de cercetare"@ro , "has research question"@en ;
    rdfs:domain kn:Endeavor ;
    rdfs:range kn:ResearchQuestion .

#################################################################
#    2. Module: notes
#################################################################

kn:Note a owl:Class ;
    rdfs:label "Notă"@ro , "Note"@en ;
    rdfs:comment "Orice unitate de cunoaștere din bază."@ro ,
                 "Any unit of knowledge in the knowledge base."@en .

kn:Excerpt a owl:Class ;
    rdfs:subClassOf kn:Note ;
    rdfs:label "Extras"@ro , "Excerpt"@en ;
    rdfs:comment "Pasaj evidențiat dintr-o sursă, importat din Zotero (Capture)."@ro ,
                 "A highlighted passage from a source, imported from Zotero (Capture)."@en .

kn:StudyNote a owl:Class ;
    rdfs:subClassOf kn:Note ;
    rdfs:label "Notă de studiu"@ro , "Study note"@en ;
    rdfs:comment "Lectura proprie a unei surse, legată de contextul ei (Distill în curs)."@ro ,
                 "Your reading of a source, bound to its context (Distill in progress)."@en .

kn:Claim a owl:Class ;
    rdfs:subClassOf kn:Note ;
    rdfs:label "Afirmație"@ro , "Claim"@en ;
    rdfs:comment "O notă care susține o propoziție ce poate fi acceptată sau contestată."@ro ,
                 "A note asserting a proposition that can be agreed or disagreed with."@en .

kn:Idea a owl:Class ;
    rdfs:subClassOf kn:Claim ;
    rdfs:label "Idee"@ro , "Idea"@en ;
    rdfs:comment "Afirmație independentă de sursă, aparținând uneia sau mai multor teme (Distill încheiat)."@ro ,
                 "A source-independent claim belonging to one or more themes (Distill finished)."@en .

kn:Evidence a owl:Class ;
    rdfs:subClassOf kn:Note ;
    rdfs:label "Dovadă"@ro , "Evidence"@en .

kn:Question a owl:Class ;
    rdfs:subClassOf kn:Note ;
    rdfs:label "Întrebare"@ro , "Question"@en .

kn:ResearchQuestion a owl:Class ;
    rdfs:subClassOf kn:Question ;
    rdfs:label "Întrebare de cercetare"@ro , "Research question"@en .

kn:NarrativeNote a owl:Class ;
    rdfs:subClassOf kn:Note ,
        [ a owl:Restriction ;
          owl:onProperty kn:epistemicOrigin ;
          owl:hasValue kn:InterpretiveOrigin ] ;
    rdfs:label "Notă narativă (portretizare)"@ro , "Narrative note (portrayal)"@en ;
    rdfs:comment """Portretizare dintr-un studiu de caz: rezultatul unui act interpretativ care exprimă
idei din teme (Express). Originea ei epistemică este întotdeauna interpretativă."""@ro ,
                 """A portrayal in a case study: the result of an interpretive act that expresses
ideas from themes (Express). Its epistemic origin is always interpretive."""@en .

kn:Interpretation a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Act interpretativ"@ro , "Interpretation"@en ;
    rdfs:comment """Actul prin care autorul exprimă una sau mai multe portretizări pornind de la idei
(prov:used), înregistrat cu autorul (prov:wasAssociatedWith) și momentul (prov:endedAtTime)."""@ro ,
                 """The act by which the author expresses one or more portrayals from ideas (prov:used),
recorded with its author (prov:wasAssociatedWith) and time (prov:endedAtTime)."""@en .

kn:Argument a owl:Class ;
    rdfs:subClassOf kn:Note ;
    rdfs:label "Argument"@ro , "Argument"@en ;
    rdfs:comment "Structură Toulmin care leagă o afirmație de temeiurile ei (Express)."@ro ,
                 "A Toulmin structure linking a claim to its grounds (Express)."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( kn:Note kn:Study kn:Endeavor kn:Requirement kn:DesignArtifact kn:DissertationSection ) .

[] a owl:AllDisjointClasses ;
    owl:members ( kn:Excerpt kn:StudyNote kn:Claim kn:Evidence kn:Question kn:NarrativeNote kn:Argument ) .

#################################################################
#    3. Module: note links and text
#################################################################

kn:inStudy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "în studiul"@ro , "in study"@en ;
    rdfs:domain kn:Note ;
    rdfs:range kn:Study .

kn:groundedIn a owl:ObjectProperty ;
    rdfs:label "fundamentat în"@ro , "grounded in"@en ;
    rdfs:comment "O idee sau notă de studiu se sprijină pe note de studiu sau extrase."@ro ,
                 "An idea or study note rests on study notes or excerpts."@en ;
    rdfs:domain kn:Note ;
    rdfs:range kn:Note .

kn:realizes a owl:ObjectProperty ;
    rdfs:label "realizează"@ro , "realizes"@en ;
    rdfs:comment "O notă narativă aplică concret o idee dintr-o temă."@ro ,
                 "A narrative note concretely applies an idea from a theme."@en ;
    rdfs:domain kn:NarrativeNote ;
    rdfs:range kn:Idea .

kn:hasPremise a owl:ObjectProperty ;
    rdfs:label "are premisa"@ro , "has premise"@en ;
    rdfs:comment "Derivată: afirmația unui argument are ca premise temeiurile acelui argument."@ro ,
                 "Derived: the claim of an argument has that argument's grounds as premises."@en ;
    owl:propertyChainAxiom ( [ owl:inverseOf kn:hasClaim ] kn:hasGrounds ) .

kn:isPremiseOf a owl:ObjectProperty ;
    rdfs:label "este premisă pentru"@ro , "is premise of"@en ;
    owl:inverseOf kn:hasPremise .

kn:anchoredIn a owl:ObjectProperty ;
    rdfs:label "ancorat în"@ro , "anchored in"@en ;
    rdfs:domain kn:Note ;
    rdfs:range oa:SpecificResource .

kn:usedIn a owl:ObjectProperty ;
    rdfs:label "folosit în"@ro , "used in"@en ;
    rdfs:domain kn:Note ;
    rdfs:range kn:DissertationSection .

kn:status a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "stare"@ro , "status"@en ;
    rdfs:comment "Valoare dintr-o schemă de stări potrivită clasei (vezi formele SHACL)."@ro ,
                 "A value from the status scheme matching the class (see the SHACL shapes)."@en ;
    rdfs:range skos:Concept .

kn:excerptKind a owl:ObjectProperty ;
    rdfs:label "tip de extras"@ro , "excerpt kind"@en ;
    rdfs:domain kn:Excerpt ;
    rdfs:range skos:Concept .

kn:epistemicOrigin a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "origine epistemică"@ro , "epistemic origin"@en ;
    rdfs:domain kn:Note ;
    rdfs:range skos:Concept .

kn:content a owl:ObjectProperty ;
    rdfs:label "conținut"@ro , "content"@en ;
    rdfs:comment "Fișier extern cu textul sau modelul (Markdown, PlantUML, PNML)."@ro ,
                 "External file holding the text or model (Markdown, PlantUML, PNML)."@en .

kn:zoteroLink a owl:ObjectProperty ;
    rdfs:label "legătură Zotero"@ro , "Zotero link"@en .

kn:statement a owl:DatatypeProperty ;
    rdfs:subPropertyOf dcterms:abstract ;
    rdfs:label "enunț"@ro , "statement"@en ;
    rdfs:comment "O singură propoziție: ideea centrală a unei note sau formularea unei cerințe."@ro ,
                 "One sentence: a note's central proposition or a requirement's wording."@en ;
    rdfs:range rdf:PlainLiteral .

kn:body a owl:DatatypeProperty ;
    rdfs:label "corp"@ro , "body"@en ;
    rdfs:range rdf:PlainLiteral .

kn:quote a owl:DatatypeProperty ;
    rdfs:label "citat"@ro , "quote"@en ;
    rdfs:domain kn:Excerpt ;
    rdfs:range xsd:string .

kn:zoteroComment a owl:DatatypeProperty ;
    rdfs:label "comentariu Zotero"@ro , "Zotero comment"@en ;
    rdfs:domain kn:Excerpt ;
    rdfs:range xsd:string .

kn:zoteroAnnotationKey a owl:DatatypeProperty ;
    rdfs:label "cheie de adnotare Zotero"@ro , "Zotero annotation key"@en ;
    rdfs:domain kn:Excerpt ;
    rdfs:range xsd:string .

kn:pageLabel a owl:DatatypeProperty ;
    rdfs:label "eticheta paginii"@ro , "page label"@en ;
    rdfs:domain oa:SpecificResource ;
    rdfs:range xsd:string .

#################################################################
#    4. Module: argumentation (Toulmin)
#################################################################

kn:hasComponent a owl:ObjectProperty ;
    rdfs:label "are componenta"@ro , "has component"@en ;
    rdfs:comment "Superproprietate a tuturor rolurilor Toulmin jucate de note într-un argument."@ro ,
                 "Superproperty of every Toulmin role that notes play in an argument."@en ;
    rdfs:domain kn:Argument ;
    rdfs:range kn:Note .

kn:hasQualification a owl:ObjectProperty ;
    rdfs:subPropertyOf kn:hasComponent ;
    rdfs:label "are justificarea calificativului"@ro , "has qualification"@en ;
    rdfs:comment """O notă care explică de ce afirmația este susținută cu tăria dată de calificativ
(de ex. «doar trei studii, toate pe ferme mici»). Nu schimbă conținutul afirmației; pentru asta, vezi kn:revises."""@ro ,
                 """A note explaining why the claim is held with the strength given by the qualifier
(e.g. "only three studies, all on small farms"). It does not change the claim's content; for that, see kn:revises."""@en ;
    rdfs:domain kn:Argument ;
    rdfs:range kn:Note .

kn:hasClaim a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf kn:hasComponent ;
    rdfs:label "are afirmația"@ro , "has claim"@en ;
    rdfs:domain kn:Argument ;
    rdfs:range kn:Claim .

kn:hasGrounds a owl:ObjectProperty ;
    rdfs:subPropertyOf kn:hasComponent ;
    rdfs:label "are temeiurile"@ro , "has grounds"@en ;
    rdfs:domain kn:Argument ;
    rdfs:range kn:Note .

kn:hasWarrant a owl:ObjectProperty ;
    rdfs:subPropertyOf kn:hasComponent ;
    rdfs:label "are garanția"@ro , "has warrant"@en ;
    rdfs:domain kn:Argument ;
    rdfs:range kn:Note .

kn:hasBacking a owl:ObjectProperty ;
    rdfs:subPropertyOf kn:hasComponent ;
    rdfs:label "are fundamentul"@ro , "has backing"@en ;
    rdfs:domain kn:Argument ;
    rdfs:range kn:Note .

kn:hasRebuttal a owl:ObjectProperty ;
    rdfs:subPropertyOf kn:hasComponent ;
    rdfs:label "are contraargumentul"@ro , "has rebuttal"@en ;
    rdfs:domain kn:Argument ;
    rdfs:range kn:Note .

kn:hasQualifier a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "are calificativul"@ro , "has qualifier"@en ;
    rdfs:comment """Tăria modală a concluziei (Certainly … Possibly), o valoare SKOS, nu o notă.
Explicația tăriei este o notă legată cu kn:hasQualification."""@ro ,
                 """The modal strength of the conclusion (Certainly … Possibly), a SKOS value, not a note.
The explanation of that strength is a note linked with kn:hasQualification."""@en ;
    rdfs:domain kn:Argument ;
    rdfs:range skos:Concept .

kn:addresses a owl:ObjectProperty ;
    rdfs:label "abordează"@ro , "addresses"@en ;
    rdfs:domain kn:Argument ;
    rdfs:range kn:ResearchQuestion .

kn:presentsArgument a owl:ObjectProperty ;
    rdfs:label "prezintă argumentul"@ro , "presents argument"@en ;
    rdfs:comment "O sursă sau o persoană prezintă un argument."@ro ,
                 "A source or a person presents an argument."@en ;
    rdfs:range kn:Argument .

kn:asserts a owl:ObjectProperty ;
    rdfs:label "afirmă"@ro , "asserts"@en ;
    rdfs:comment "Derivată: cine prezintă un argument afirmă concluzia lui."@ro ,
                 "Derived: whoever presents an argument asserts its claim."@en ;
    owl:propertyChainAxiom ( kn:presentsArgument kn:hasClaim ) .

kn:revises a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasRevisionOf ;
    rdfs:label "revizuiește"@ro , "revises"@en ;
    rdfs:comment """Afirmația-subiect este o versiune nouă a afirmației-obiect, cu conținut schimbat
(de regulă îngustat sau corectat). Afirmația veche rămâne, cu starea Superseded.
Nu face parte din kn:tracesTo: o revizuire este istorie, nu sprijin."""@ro ,
                 """The subject claim is a new version of the object claim, with changed content
(typically narrowed or corrected). The old claim remains, with status Superseded.
Not part of kn:tracesTo: a revision is history, not support."""@en ;
    rdfs:domain kn:Claim ;
    rdfs:range kn:Claim .

# Toulmin roles as defined classes: membership is inferred, never asserted.

kn:Conclusion a owl:Class ;
    rdfs:label "Concluzie"@ro , "Conclusion"@en ;
    rdfs:comment """Rolul de afirmație într-un argument: nota pe care argumentul o stabilește.
Diferă de kn:Claim, care este un tip de notă: o afirmație revizuită (Superseded) rămâne Claim,
dar nu mai este Conclusion dacă niciun argument nu o mai are drept concluzie."""@ro ,
                 """The claim role in an argument: the note the argument establishes.
Differs from kn:Claim, which is a note kind: a superseded claim stays a Claim,
but is no longer a Conclusion once no argument concludes it."""@en ;
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty [ owl:inverseOf kn:hasClaim ] ;
        owl:someValuesFrom kn:Argument ] .

kn:Grounds a owl:Class ;
    rdfs:label "Temeiuri"@ro , "Grounds"@en ;
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty [ owl:inverseOf kn:hasGrounds ] ;
        owl:someValuesFrom kn:Argument ] .

kn:Warrant a owl:Class ;
    rdfs:label "Garanție"@ro , "Warrant"@en ;
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty [ owl:inverseOf kn:hasWarrant ] ;
        owl:someValuesFrom kn:Argument ] .

kn:Backing a owl:Class ;
    rdfs:label "Fundament"@ro , "Backing"@en ;
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty [ owl:inverseOf kn:hasBacking ] ;
        owl:someValuesFrom kn:Argument ] .

kn:Rebuttal a owl:Class ;
    rdfs:label "Contraargument"@ro , "Rebuttal"@en ;
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty [ owl:inverseOf kn:hasRebuttal ] ;
        owl:someValuesFrom kn:Argument ] .

kn:Qualification a owl:Class ;
    rdfs:label "Justificare a calificativului"@ro , "Qualification"@en ;
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty [ owl:inverseOf kn:hasQualification ] ;
        owl:someValuesFrom kn:Argument ] .

kn:ArgumentComponent a owl:Class ;
    rdfs:label "Componentă a argumentului"@ro , "Argument component"@en ;
    rdfs:comment """Orice notă care joacă un rol într-un argument. Rolurile NU sunt disjuncte:
aceeași notă poate fi temei într-un argument și garanție în altul."""@ro ,
                 """Any note playing a role in some argument. Roles are NOT disjoint:
the same note can be grounds in one argument and warrant in another."""@en ;
    owl:equivalentClass [ a owl:Restriction ;
        owl:onProperty [ owl:inverseOf kn:hasComponent ] ;
        owl:someValuesFrom kn:Argument ] .

#################################################################
#    5. Module: reification into engineering artifacts
#################################################################

kn:Requirement a owl:Class ;
    rdfs:label "Cerință"@ro , "Requirement"@en ;
    rdfs:comment "Cerință de implementare pentru o aplicație, un serviciu sau un algoritm."@ro ,
                 "An implementation requirement for an application, service or algorithm."@en .

kn:DesignArtifact a owl:Class ;
    rdfs:label "Artefact de proiectare"@ro , "Design artifact"@en .

kn:UMLDiagram a owl:Class ;
    rdfs:subClassOf kn:DesignArtifact ;
    rdfs:label "Diagramă UML"@ro , "UML diagram"@en .

kn:PetriNet a owl:Class ;
    rdfs:subClassOf kn:DesignArtifact ;
    rdfs:label "Rețea Petri"@ro , "Petri net"@en .

kn:AlgorithmSpec a owl:Class ;
    rdfs:subClassOf kn:DesignArtifact ;
    rdfs:label "Specificație de algoritm"@ro , "Algorithm specification"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( kn:UMLDiagram kn:PetriNet kn:AlgorithmSpec ) .

kn:reifies a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:label "reifică"@ro , "reifies"@en ;
    rdfs:comment """Transformă note (afirmații, argumente) într-o resursă de inginerie care le realizează.
Nu este reificarea RDF a declarațiilor (rdf:Statement)."""@ro ,
                 """Turns notes (statements, arguments) into an engineering resource that realizes them.
Not RDF statement reification (rdf:Statement)."""@en ;
    rdfs:domain kn:Requirement ;
    rdfs:range kn:Note .

kn:satisfies a owl:ObjectProperty ;
    rdfs:label "satisface"@ro , "satisfies"@en ;
    rdfs:domain kn:DesignArtifact ;
    rdfs:range kn:Requirement .

kn:implements a owl:ObjectProperty ;
    rdfs:label "implementează"@ro , "implements"@en ;
    rdfs:comment "Cod (fișier, modul, commit) care implementează un artefact de proiectare."@ro ,
                 "Code (file, module, commit) implementing a design artifact."@en ;
    rdfs:range kn:DesignArtifact .

kn:requirementKind a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tip de cerință"@ro , "requirement kind"@en ;
    rdfs:domain kn:Requirement ;
    rdfs:range skos:Concept .

kn:diagramType a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "tip de diagramă"@ro , "diagram type"@en ;
    rdfs:domain kn:UMLDiagram ;
    rdfs:range skos:Concept .

#################################################################
#    6. Module: formal traceability
#################################################################

kn:tracesTo a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "trasabil la"@ro , "traces to"@en ;
    rdfs:comment """Relație tranzitivă de trasabilitate: de la cod și proiectare, prin cerințe și argumente,
până la extrase și ancore din surse."""@ro ,
                 """Transitive traceability: from code and design, through requirements and arguments,
down to excerpts and source anchors."""@en .

kn:implements  rdfs:subPropertyOf kn:tracesTo .   # code → design
kn:satisfies   rdfs:subPropertyOf kn:tracesTo .   # design → requirement
kn:reifies     rdfs:subPropertyOf kn:tracesTo .   # requirement → argument or idea
kn:hasGrounds  rdfs:subPropertyOf kn:tracesTo .   # argument → grounds
kn:hasWarrant  rdfs:subPropertyOf kn:tracesTo .   # argument → warrant
kn:hasBacking  rdfs:subPropertyOf kn:tracesTo .   # argument → backing
kn:hasQualification rdfs:subPropertyOf kn:tracesTo .   # argument → why that strength
kn:hasPremise  rdfs:subPropertyOf kn:tracesTo .   # claim → premise
kn:realizes    rdfs:subPropertyOf kn:tracesTo .   # narrative note → idea
kn:groundedIn  rdfs:subPropertyOf kn:tracesTo .   # idea → study note → excerpt
kn:anchoredIn  rdfs:subPropertyOf kn:tracesTo .   # excerpt → anchor in source

kn:expressedFrom a owl:ObjectProperty ;
    rdfs:label "exprimat din"@ro , "expressed from"@en ;
    rdfs:comment "Derivată: o portretizare urmează tot ce a folosit actul interpretativ care a generat-o."@ro ,
                 "Derived: a portrayal traces to everything used by the interpretive act that generated it."@en ;
    rdfs:subPropertyOf kn:tracesTo ;
    owl:propertyChainAxiom ( prov:wasGeneratedBy prov:used ) .

#################################################################
#    7. Controlled vocabularies (SKOS)
#################################################################

# --- Note statuses ---
kn:NoteStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Stări ale notelor"@ro , "Note statuses"@en .
kn:Draft a skos:Concept ; skos:inScheme kn:NoteStatusScheme ; skos:topConceptOf kn:NoteStatusScheme ;
    skos:prefLabel "Ciornă"@ro , "Draft"@en .
kn:Reviewed a skos:Concept ; skos:inScheme kn:NoteStatusScheme ; skos:topConceptOf kn:NoteStatusScheme ;
    skos:prefLabel "Revizuit"@ro , "Reviewed"@en .
kn:Disputed a skos:Concept ; skos:inScheme kn:NoteStatusScheme ; skos:topConceptOf kn:NoteStatusScheme ;
    skos:prefLabel "Contestat"@ro , "Disputed"@en .
kn:Superseded a skos:Concept ; skos:inScheme kn:NoteStatusScheme ; skos:topConceptOf kn:NoteStatusScheme ;
    skos:prefLabel "Înlocuit"@ro , "Superseded"@en ;
    skos:definition "Afirmație păstrată ca istorie, revizuită de o afirmație nouă (kn:revises)."@ro ,
                    "A claim kept as history, revised by a newer claim (kn:revises)."@en .

# --- Study statuses ---
kn:StudyStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Stări ale studiilor"@ro , "Study statuses"@en .
kn:Open a skos:Concept ; skos:inScheme kn:StudyStatusScheme ; skos:topConceptOf kn:StudyStatusScheme ;
    skos:prefLabel "Deschis"@ro , "Open"@en ; skos:notation "1" .
kn:Distilled a skos:Concept ; skos:inScheme kn:StudyStatusScheme ; skos:topConceptOf kn:StudyStatusScheme ;
    skos:prefLabel "Distilat"@ro , "Distilled"@en ; skos:notation "2" .
kn:Closed a skos:Concept ; skos:inScheme kn:StudyStatusScheme ; skos:topConceptOf kn:StudyStatusScheme ;
    skos:prefLabel "Închis"@ro , "Closed"@en ; skos:notation "3" .

# --- Endeavor statuses ---
kn:EndeavorStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Stări ale demersurilor"@ro , "Endeavor statuses"@en .
kn:Active a skos:Concept ; skos:inScheme kn:EndeavorStatusScheme ; skos:topConceptOf kn:EndeavorStatusScheme ;
    skos:prefLabel "Activ"@ro , "Active"@en .
kn:Completed a skos:Concept ; skos:inScheme kn:EndeavorStatusScheme ; skos:topConceptOf kn:EndeavorStatusScheme ;
    skos:prefLabel "Finalizat"@ro , "Completed"@en .
kn:Archived a skos:Concept ; skos:inScheme kn:EndeavorStatusScheme ; skos:topConceptOf kn:EndeavorStatusScheme ;
    skos:prefLabel "Arhivat"@ro , "Archived"@en .

# --- Study methods ---
kn:MethodScheme a skos:ConceptScheme ;
    skos:prefLabel "Metode de studiu"@ro , "Study methods"@en .
kn:LiteratureReview a skos:Concept ; skos:inScheme kn:MethodScheme ; skos:topConceptOf kn:MethodScheme ;
    skos:prefLabel "Recenzie de literatură"@ro , "Literature review"@en ;
    skos:definition "Singura metodă permisă pentru studiile unei teme."@ro ,
                    "The only method allowed for theme studies."@en .
kn:CaseStudy a skos:Concept ; skos:inScheme kn:MethodScheme ; skos:topConceptOf kn:MethodScheme ;
    skos:prefLabel "Studiu de caz"@ro , "Case study"@en .
kn:DesignStudy a skos:Concept ; skos:inScheme kn:MethodScheme ; skos:topConceptOf kn:MethodScheme ;
    skos:prefLabel "Studiu de proiectare"@ro , "Design study"@en .

# --- Toulmin qualifiers, ordered by strength ---
kn:QualifierScheme a skos:ConceptScheme ;
    skos:prefLabel "Calificative"@ro , "Qualifiers"@en .
kn:Certainly a skos:Concept ; skos:inScheme kn:QualifierScheme ; skos:topConceptOf kn:QualifierScheme ;
    skos:prefLabel "Cu certitudine"@ro , "Certainly"@en ; skos:notation "1" .
kn:Probably a skos:Concept ; skos:inScheme kn:QualifierScheme ; skos:topConceptOf kn:QualifierScheme ;
    skos:prefLabel "Probabil"@ro , "Probably"@en ; skos:notation "2" .
kn:Presumably a skos:Concept ; skos:inScheme kn:QualifierScheme ; skos:topConceptOf kn:QualifierScheme ;
    skos:prefLabel "Presupus"@ro , "Presumably"@en ; skos:notation "3" .
kn:Possibly a skos:Concept ; skos:inScheme kn:QualifierScheme ; skos:topConceptOf kn:QualifierScheme ;
    skos:prefLabel "Posibil"@ro , "Possibly"@en ; skos:notation "4" .

# --- Epistemic origin ---
kn:EpistemicOriginScheme a skos:ConceptScheme ;
    skos:prefLabel "Origini epistemice"@ro , "Epistemic origins"@en .
kn:ExperimentalOrigin a skos:Concept ; skos:inScheme kn:EpistemicOriginScheme ; skos:topConceptOf kn:EpistemicOriginScheme ;
    skos:prefLabel "Experimentală"@ro , "Experimental"@en .
kn:InterpretiveOrigin a skos:Concept ; skos:inScheme kn:EpistemicOriginScheme ; skos:topConceptOf kn:EpistemicOriginScheme ;
    skos:prefLabel "Interpretativă"@ro , "Interpretive"@en .

[] a owl:AllDifferent ;
    owl:distinctMembers ( kn:ExperimentalOrigin kn:InterpretiveOrigin ) .

# --- Excerpt kinds (mapped from Zotero highlight colors) ---
kn:ExcerptKindScheme a skos:ConceptScheme ;
    skos:prefLabel "Tipuri de extrase"@ro , "Excerpt kinds"@en .
kn:ClaimPassage a skos:Concept ; skos:inScheme kn:ExcerptKindScheme ; skos:topConceptOf kn:ExcerptKindScheme ;
    skos:prefLabel "Pasaj: afirmație"@ro , "Claim passage"@en ; skos:notation "yellow" .
kn:MethodPassage a skos:Concept ; skos:inScheme kn:ExcerptKindScheme ; skos:topConceptOf kn:ExcerptKindScheme ;
    skos:prefLabel "Pasaj: metodă"@ro , "Method passage"@en ; skos:notation "green" .
kn:EvidencePassage a skos:Concept ; skos:inScheme kn:ExcerptKindScheme ; skos:topConceptOf kn:ExcerptKindScheme ;
    skos:prefLabel "Pasaj: dovadă"@ro , "Evidence passage"@en ; skos:notation "blue" .
kn:LimitationPassage a skos:Concept ; skos:inScheme kn:ExcerptKindScheme ; skos:topConceptOf kn:ExcerptKindScheme ;
    skos:prefLabel "Pasaj: limitare"@ro , "Limitation passage"@en ; skos:notation "red" .
kn:DefinitionPassage a skos:Concept ; skos:inScheme kn:ExcerptKindScheme ; skos:topConceptOf kn:ExcerptKindScheme ;
    skos:prefLabel "Pasaj: definiție"@ro , "Definition passage"@en ; skos:notation "purple" .

# --- Requirement kinds ---
kn:RequirementKindScheme a skos:ConceptScheme ;
    skos:prefLabel "Tipuri de cerințe"@ro , "Requirement kinds"@en .
kn:Functional a skos:Concept ; skos:inScheme kn:RequirementKindScheme ; skos:topConceptOf kn:RequirementKindScheme ;
    skos:prefLabel "Funcțională"@ro , "Functional"@en .
kn:NonFunctional a skos:Concept ; skos:inScheme kn:RequirementKindScheme ; skos:topConceptOf kn:RequirementKindScheme ;
    skos:prefLabel "Nefuncțională"@ro , "Non-functional"@en .

# --- UML diagram types ---
kn:DiagramTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "Tipuri de diagrame UML"@ro , "UML diagram types"@en .
kn:ClassDiagram a skos:Concept ; skos:inScheme kn:DiagramTypeScheme ; skos:topConceptOf kn:DiagramTypeScheme ;
    skos:prefLabel "Diagramă de clase"@ro , "Class diagram"@en .
kn:ComponentDiagram a skos:Concept ; skos:inScheme kn:DiagramTypeScheme ; skos:topConceptOf kn:DiagramTypeScheme ;
    skos:prefLabel "Diagramă de componente"@ro , "Component diagram"@en .
kn:DeploymentDiagram a skos:Concept ; skos:inScheme kn:DiagramTypeScheme ; skos:topConceptOf kn:DiagramTypeScheme ;
    skos:prefLabel "Diagramă de desfășurare"@ro , "Deployment diagram"@en .
kn:SequenceDiagram a skos:Concept ; skos:inScheme kn:DiagramTypeScheme ; skos:topConceptOf kn:DiagramTypeScheme ;
    skos:prefLabel "Diagramă de secvență"@ro , "Sequence diagram"@en .
kn:StateDiagram a skos:Concept ; skos:inScheme kn:DiagramTypeScheme ; skos:topConceptOf kn:DiagramTypeScheme ;
    skos:prefLabel "Diagramă de stări"@ro , "State machine diagram"@en .
kn:ActivityDiagram a skos:Concept ; skos:inScheme kn:DiagramTypeScheme ; skos:topConceptOf kn:DiagramTypeScheme ;
    skos:prefLabel "Diagramă de activitate"@ro , "Activity diagram"@en .
